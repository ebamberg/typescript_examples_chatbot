{
  "uid": "llm-stability-retries",
  "title": "LLM Stability & Retries",
  "description": "How often calls fail and need a retry, whether retries actually recover the call, and which errors are driving the retry loop - with red-flagged traces pulled straight from Tempo.",
  "tags": [
    "llm",
    "observability",
    "stability",
    "retries"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "LLM Performance & Bottlenecks",
      "type": "dashboards",
      "tags": [
        "llm",
        "bottlenecks"
      ],
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "LLM Cost & Token Analytics",
      "type": "dashboards",
      "tags": [
        "llm",
        "cost"
      ],
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(gen_ai_request_count_total, gen_ai_request_model)",
          "refId": "model"
        },
        "label": "Model",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Stability Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Retry Attempts",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(gen_ai_request_retries_count_total{gen_ai_request_model=~\"$model\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 1 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "description": "How many times withRetryOnError() had to retry a chat completion call, from the gen_ai.request.retries.count counter."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Retries Exhausted (Give-ups)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(gen_ai_request_retries_exhausted_count_total{gen_ai_request_model=~\"$model\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#d03b3b", "value": 1 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "description": "Calls that still failed after every retry - these propagate as a hard error to the caller. Any non-zero value here deserves attention."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg Retries / Request",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(gen_ai_request_retries_count_total{gen_ai_request_model=~\"$model\"}[$__range])) / sum(increase(gen_ai_request_count_total{gen_ai_request_model=~\"$model\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 0.1 },
              { "color": "#d03b3b", "value": 0.5 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "description": "Retry attempts per request - a rising trend means upstream calls are getting less reliable even if they eventually succeed."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Final Error Rate",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(increase(gen_ai_request_errors_count_total{gen_ai_request_model=~\"$model\"}[$__range])) / sum(increase(gen_ai_request_count_total{gen_ai_request_model=~\"$model\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 1 },
              { "color": "#d03b3b", "value": 5 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "description": "Share of requests that ended in an error after retries were exhausted - the outcome the caller actually sees."
    },
    {
      "id": 6,
      "type": "row",
      "title": "Retries Over Time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Retries on Errors — by Model",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "60 * sum by (gen_ai_request_model) (rate(gen_ai_request_retries_count_total{gen_ai_request_model=~\"$model\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{gen_ai_request_model}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "description": "Retry attempts per minute reported by withRetryOnError(), stacked by model. This is the core 'retries on errors over time' panel.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "normal", "group": "A" },
            "gradientMode": "none"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#0ca30c", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Retries Exhausted (Give-ups) — by Model",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "60 * sum by (gen_ai_request_model) (rate(gen_ai_request_retries_exhausted_count_total{gen_ai_request_model=~\"$model\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{gen_ai_request_model}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "description": "Requests per minute that still failed after all retries were used up - retries hiding a real outage would show up here.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "normal", "group": "A" },
            "gradientMode": "none"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#d03b3b", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Retry Causes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Retries by Error Type",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(10, sum by (error_type) (gen_ai_request_retries_count_total{gen_ai_request_model=~\"$model\"}))",
          "refId": "A",
          "legendFormat": "{{error_type}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "description": "Which error types are triggering retries most often - a direct counter read since sparse error events often lack the sample history rate()/increase() needs.",
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#0ca30c", "value": null }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Retries Exhausted — by Error Type & Model",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(10, sum(gen_ai_request_retries_exhausted_count_total) by (error_type, gen_ai_request_model))",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Cumulative give-up counts since the app started, broken down by error type and model.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false },
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Success vs Failure",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Request Outcome Rate (ok vs error)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (gen_ai_response_status) (rate(gen_ai_request_duration_seconds_count{gen_ai_request_model=~\"$model\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{gen_ai_response_status}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "description": "Final request outcome (after any retries) - derived from the gen_ai.request.duration histogram's ok/error status label.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "normal", "group": "A" },
            "gradientMode": "none"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#0ca30c", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ok" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ca30c" } }]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 14,
      "type": "heatmap",
      "title": "Duration Distribution — Failed Requests",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(gen_ai_request_duration_seconds_bucket{gen_ai_response_status=\"error\", gen_ai_request_model=~\"$model\"}[$__rate_interval])) by (le)",
          "refId": "A",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "description": "How long failing calls take before giving up - a cluster near the backoff ceiling suggests timeouts rather than fast-failing errors.",
      "options": {
        "calculate": false,
        "yAxis": { "unit": "s", "axisPlacement": "left" },
        "color": { "mode": "scheme", "scheme": "Reds", "steps": 64, "reverse": false, "exponent": 0.5 },
        "cellGap": 1,
        "tooltip": { "show": true, "yHistogram": true },
        "legend": { "show": true },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "rowsFrame": { "layout": "auto" }
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 15,
      "type": "row",
      "title": "🚩 Red-Flagged Traces",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "collapsed": false
    },
    {
      "id": 16,
      "type": "table",
      "title": "Traces That Needed a Retry",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 35 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{span.retry.attempt >= 1}",
          "refId": "A",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "description": "Traces where at least one retry.attempt span attribute is >= 1 - open one to see exactly which call failed and how many attempts it took to recover.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false },
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "table",
      "title": "Failed After Retries Exhausted",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 35 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{status=error && span.retry.attempt = 3}",
          "refId": "A",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "description": "Traces where the final attempt (retry.attempt = 3, the default MAX_RETRIES in withRetryOnError) still ended in an error - a hard failure the caller saw. Adjust the attempt number if maxRetries is changed.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false },
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": []
      }
    }
  ],
  "style": "dark"
}
