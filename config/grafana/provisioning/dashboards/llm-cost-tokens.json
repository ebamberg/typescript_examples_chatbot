{
  "uid": "llm-cost-tokens",
  "title": "LLM Cost & Token Analytics",
  "description": "Spend, cost-per-request percentiles, cache efficiency and token/complexity trends across models, with individual red-flagged expensive traces pulled from Tempo.",
  "tags": [
    "llm",
    "observability",
    "cost",
    "tokens"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "LLM Performance & Bottlenecks",
      "type": "dashboards",
      "tags": [
        "llm",
        "bottlenecks"
      ],
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "LLM Stability & Retries",
      "type": "dashboards",
      "tags": [
        "llm",
        "stability"
      ],
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(gen_ai_request_count_total, gen_ai_request_model)",
          "refId": "model"
        },
        "label": "Model",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Cost Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Spend",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(gen_ai_response_price_count_total{gen_ai_request_model=~\"$model\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "description": "Total LLM spend across the selected time range and models."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Requests",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(gen_ai_request_count_total{gen_ai_request_model=~\"$model\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "description": ""
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg Cost / Request",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(gen_ai_response_cost_usd_sum{gen_ai_request_model=~\"$model\"}[$__range])) / sum(increase(gen_ai_response_cost_usd_count{gen_ai_request_model=~\"$model\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "description": ""
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cache Hit Ratio",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(increase(gen_ai_cache_token_count_total{gen_ai_request_model=~\"$model\"}[$__range])) / sum(increase(gen_ai_request_input_tokens_count_total{gen_ai_request_model=~\"$model\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 10
              },
              {
                "color": "#0ca30c",
                "value": 30
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "description": "Higher is better - share of prompt tokens served from the provider's prompt cache instead of being billed fresh."
    },
    {
      "id": 6,
      "type": "row",
      "title": "🚩 Cost Traps",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cost per Request — p50 / p90 / p95 / p99",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum(rate(gen_ai_response_cost_usd_bucket{gen_ai_request_model=~\"$model\"}[$__rate_interval])) by (le))",
          "refId": "A",
          "legendFormat": "p50",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.90, sum(rate(gen_ai_response_cost_usd_bucket{gen_ai_request_model=~\"$model\"}[$__rate_interval])) by (le))",
          "refId": "B",
          "legendFormat": "p90",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(gen_ai_response_cost_usd_bucket{gen_ai_request_model=~\"$model\"}[$__rate_interval])) by (le))",
          "refId": "C",
          "legendFormat": "p95",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum(rate(gen_ai_response_cost_usd_bucket{gen_ai_request_model=~\"$model\"}[$__rate_interval])) by (le))",
          "refId": "D",
          "legendFormat": "p99",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "description": "A rising p99 with a flat p50 means a small share of requests are quietly driving your bill.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 0.01
              },
              {
                "color": "#d03b3b",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Spend by Model",
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_request_model) (increase(gen_ai_response_price_count_total[$__range]))",
          "refId": "A",
          "legendFormat": "{{gen_ai_request_model}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "description": "",
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "google/gemini-3.5-flash"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "openai/gpt-4o-mini"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "qwen/qwen3.8-27b"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "bargauge",
